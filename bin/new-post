#!/usr/bin/env bash
#
# Create a new blog post in _posts/ with the front matter this site expects.
#
# Run with no arguments for interactive prompts, or pass flags to skip them.
#
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: bin/new-post                      # interactive
       bin/new-post "Post title" [options]

Options:
  -d, --date YYYY-MM-DD    Publication date (default: today)
  -s, --slug SLUG          Override the slug derived from the title
  -D, --description TEXT   Meta description (left empty by default)
  -i, --image FILE         og:image, relative to /images (e.g. 2026/08/og.png)
  -m, --mermaid            Enable mermaid diagrams
  -c, --codepen            Enable the CodePen embed script
  -H, --no-highlight       Disable Prism syntax highlighting (on by default)
  -o, --open               Open the new post in $EDITOR
  -h, --help               Show this help
USAGE
}

title=""
date=""
slug=""
description=""
image=""
mermaid="false"
codepen="false"
codehighlighter="true"
open_editor="false"
interactive="false"

[ $# -eq 0 ] && interactive="true"

while [ $# -gt 0 ]; do
  case "$1" in
    -d|--date)         date="${2:-}"; shift 2 ;;
    -s|--slug)         slug="${2:-}"; shift 2 ;;
    -D|--description)  description="${2:-}"; shift 2 ;;
    -i|--image)        image="${2:-}"; shift 2 ;;
    -m|--mermaid)      mermaid="true"; shift ;;
    -c|--codepen)      codepen="true"; shift ;;
    -H|--no-highlight) codehighlighter="false"; shift ;;
    -o|--open)         open_editor="true"; shift ;;
    -h|--help)         usage; exit 0 ;;
    -*)                echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    *)
      if [ -n "$title" ]; then
        echo "Unexpected argument: $1 (quote the title)" >&2; exit 1
      fi
      title="$1"; shift ;;
  esac
done

# Slug: lowercase, drop apostrophes, non-alphanumerics become dashes.
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e "s/['\`’]//g" -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//'
}

valid_date() {
  printf '%s' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
}

ask() { # ask <prompt> <default>
  local reply=""
  if [ -n "$2" ]; then
    read -r -p "$1 [$2]: " reply || true
    printf '%s' "${reply:-$2}"
  else
    read -r -p "$1: " reply || true
    printf '%s' "$reply"
  fi
}

ask_yn() { # ask_yn <prompt> -> echoes true/false, default no
  local reply=""
  read -r -p "$1 [y/N]: " reply || true
  case "$reply" in
    [yY]|[yY][eE][sS]) printf 'true' ;;
    *)                 printf 'false' ;;
  esac
}

if [ "$interactive" = "true" ]; then
  if [ ! -t 0 ]; then
    echo "Error: no arguments given and stdin is not a terminal." >&2
    usage >&2
    exit 1
  fi

  while [ -z "$title" ]; do
    title=$(ask "Title" "")
    [ -z "$title" ] && echo "  A title is required." >&2
  done

  slug=$(ask "Slug" "$(slugify "$title")")

  while :; do
    date=$(ask "Date" "$(date +%F)")
    valid_date "$date" && break
    echo "  Use YYYY-MM-DD." >&2
  done

  mermaid=$(ask_yn "Mermaid diagrams?")
  image=$(ask "og:image (blank for none)" "")
fi

if [ -z "$title" ]; then
  echo "Error: a post title is required." >&2
  usage >&2
  exit 1
fi

date="${date:-$(date +%F)}"
if ! valid_date "$date"; then
  echo "Error: --date must be YYYY-MM-DD (got '$date')." >&2
  exit 1
fi

[ -z "$slug" ] && slug=$(slugify "$title")
if [ -z "$slug" ]; then
  echo "Error: could not derive a slug from the title; pass --slug." >&2
  exit 1
fi

root=$(cd "$(dirname "$0")/.." && pwd)
file="$root/_posts/$date-$slug.md"
url="/${date//-//}/$slug.html"

if [ -e "$file" ]; then
  echo "Error: _posts/$date-$slug.md already exists." >&2
  exit 1
fi

if [ "$interactive" = "true" ]; then
  echo
  echo "  file: _posts/$date-$slug.md"
  echo "  url:  $url"
  echo
  confirm=""
  read -r -p "Create? [Y/n]: " confirm || true
  case "$confirm" in
    [nN]|[nN][oO]) echo "Aborted."; exit 0 ;;
  esac
fi

# Escape for a single-quoted YAML scalar: ' becomes ''
yq() { printf '%s' "$1" | sed "s/'/''/g"; }

{
  printf -- '---\n'
  printf 'layout: post\n'
  printf "title:  '%s'\n" "$(yq "$title")"
  printf 'codepen: %s\n' "$codepen"
  printf 'codehighlighter: %s\n' "$codehighlighter"
  printf 'mermaid: %s\n' "$mermaid"
  printf 'date: %s 00:00:00\n' "$date"
  printf "description: '%s'\n" "$(yq "$description")"
  [ -n "$image" ] && printf 'image: %s\n' "$image"
  printf -- '---\n\n'
} > "$file"

if [ -n "$image" ]; then
  mkdir -p "$root/images/$(dirname "$image")"
fi

echo "Created _posts/$date-$slug.md"
echo "URL:    $url"

if [ "$open_editor" = "true" ]; then
  "${EDITOR:-vi}" "$file"
fi
